# Modèle de configuration du « cerveau local ».
#
# Copier ce fichier en .env (jamais publié : ignoré par Git), puis remplir
# les valeurs. Le code lit ces variables via localenv.py.
#
#   copy .env.example .env        (Windows PowerShell)
#
# ---------------------------------------------------------------------------
# OBLIGATOIRE
# ---------------------------------------------------------------------------

# URL publique de la boîte aux lettres en ligne (déployée sur PythonAnywhere).
MAILBOX_URL=https://orangentleman.pythonanywhere.com

# Secret partagé avec la boîte aux lettres (en-tête X-Mailbox-Secret).
# C'est TOI qui le génères et le colles ici ET côté serveur ; ne le partage
# jamais. Sert à autoriser `pull` et `ack`.
MAILBOX_SECRET=

# Clé API Google Gemini (gratuite, sans carte). Sert à la commande `review`.
# À coller toi-même ; elle ne doit jamais apparaître ailleurs que dans ce .env.
GEMINI_API_KEY=

# --- Supabase (comptes des contributeurs connectés) ------------------------
# Depuis la phase 4, les visiteurs CONNECTÉS envoient leur proposition dans
# la table `contributions` de Supabase (au lieu de la boîte PythonAnywhere).
# Les commandes `pull-cloud` (lecture) et `push` (renvoi du statut) en ont
# besoin. Si tu n'utilises pas encore Supabase, laisse ces deux lignes
# vides : les autres commandes fonctionnent sans.

# URL de ton projet Supabase, ex. https://xxxxxxxx.supabase.co
# (la MÊME que dans index.html — ce n'est pas un secret).
SUPABASE_URL=https://fipdatwirklhgdbujobz.supabase.co

# Clé « service_role » de Supabase (Project Settings → API → service_role).
# ⚠ TOUTE-PUISSANTE : elle ignore les règles de sécurité (RLS) et peut tout
# lire / tout modifier. Elle ne doit JAMAIS finir dans le site ni sur GitHub —
# uniquement ici, dans ce .env qui reste sur ton PC (ignoré par Git).
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# OPTIONNEL (valeurs par défaut entre parenthèses)
# ---------------------------------------------------------------------------

# Modèle Gemini utilisé par `review` (par défaut : gemini-flash-latest,
# un alias qui suit toujours le modèle « flash » courant).
#GEMINI_MODEL=gemini-flash-latest

# Pause en secondes entre deux appels Gemini, pour ménager le quota (1.0).
#GEMINI_SLEEP_S=1.0

# Port du tableau de bord local `dashboard` (5002).
#DASHBOARD_PORT=5002

# Nombre de boîtes relues par lot depuis le dashboard (20).
#DASHBOARD_REVIEW_BATCH=20
