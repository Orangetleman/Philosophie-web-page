# Modèle de configuration du « cerveau local ».
#
# Copier ce fichier en .env (jamais publié : ignoré par Git), puis remplir
# les valeurs. Le code lit ces variables via localenv.py.
#
#   copy .env.example .env        (Windows PowerShell)
#
# ---------------------------------------------------------------------------
# OBLIGATOIRE
# ---------------------------------------------------------------------------

# URL publique de la boîte aux lettres en ligne (déployée sur PythonAnywhere).
MAILBOX_URL=https://orangentleman.pythonanywhere.com

# Secret partagé avec la boîte aux lettres (en-tête X-Mailbox-Secret).
# C'est TOI qui le génères et le colles ici ET côté serveur ; ne le partage
# jamais. Sert à autoriser `pull` et `ack`.
MAILBOX_SECRET=

# Clé API Google Gemini (gratuite, sans carte). Sert à la commande `review`.
# À coller toi-même ; elle ne doit jamais apparaître ailleurs que dans ce .env.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONNEL (valeurs par défaut entre parenthèses)
# ---------------------------------------------------------------------------

# Modèle Gemini utilisé par `review` (gemini-1.5-flash).
#GEMINI_MODEL=gemini-1.5-flash

# Pause en secondes entre deux appels Gemini, pour ménager le quota (1.0).
#GEMINI_SLEEP_S=1.0

# Port du tableau de bord local `dashboard` (5002).
#DASHBOARD_PORT=5002

# Nombre de boîtes relues par lot depuis le dashboard (20).
#DASHBOARD_REVIEW_BATCH=20
