# Base SQLite — données locales, jamais commitées
proposals.db
proposals.db-journal

# Secrets du cerveau local (URL + secret de la boîte, clé Gemini).
# Le .env n'est JAMAIS publié ; seul .env.example (le modèle) l'est.
.env

# Environnement virtuel Python local éventuel.
.venv/

# Exports — artefacts générés par `aggregate.py export` (rangés dans
# reviews/ depuis peu ; le motif sans slash couvre aussi reviews/review_*.txt)
review_*.txt

# Contenu des dossiers (sauf le placeholder .gitkeep)
inbox/*
processed/*
quarantine/*
reviews/*
!inbox/.gitkeep
!processed/.gitkeep
!quarantine/.gitkeep
!reviews/.gitkeep

# Artefacts Python
__pycache__/
*.pyc
